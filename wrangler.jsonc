// Configuración del Worker "baseweb" en Cloudflare.
// Sirve la web estática de esta carpeta y el formulario en /api/contacto (worker/index.js).
// Los secretos (RESEND_API_KEY, TURNSTILE_SECRET, MAIL_TO, WEBHOOK_URL) se guardan en el panel de Cloudflare.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baseweb",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // Conserva las variables creadas en el panel de Cloudflare en cada despliegue
  "keep_vars": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/wp-content/uploads/*", "/media/*", "/calculadora-de-presupuesto", "/calculadora-presupuesto", "/acceso", "/salir", "/presupuestos", "/presupuesto"]
  },
  // Imágenes en Cloudflare R2 (bucket "domotica-imagenes"):
  //   /wp-content/uploads/...  imágenes migradas de WordPress (mismas URLs de siempre)
  //   /media/...               imágenes nuevas, organizadas por carpetas
  "r2_buckets": [{ "binding": "IMAGENES", "bucket_name": "domotica-imagenes" }],
  "observability": { "enabled": true }
}
